{% if product.metafields.custom.tecnicas_de_impresion != blank %}
  <label for="decorado-select">Elige tipo de decorado:</label>
  <select id="decorado-select">
    <option value="" disabled selected>Seleccione técnica de impresión</option>
    <option value="Sin decorado">Sin decorado</option>
    {% assign techniques = product.metafields.custom.tecnicas_de_impresion.value | split: '-' %}
    {% for technique in techniques %}
      <option value="{{ technique }}">{{ technique }}</option>
    {% endfor %}
  </select>
{% endif %}

<label for="medida-select" style="display:block; margin-top:10px;">Elige la medida:</label>
<select id="medida-select" disabled>
  <option value="" disabled selected>Seleccione primero el tipo de decorado</option>
</select>



