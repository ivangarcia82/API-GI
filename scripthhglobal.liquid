  function calcularPrecioDecoradoConDetalle(tipoDecorado, superficie, cantidad, medida) {
    const result = {
      error: null,
      totalPrice: 0,
      unitPrice: 0,
      neededQtyForMin: 0,
      isMinPriceUsed: false
    };
  
    let superficieFinal = superficie.toUpperCase();
  
    // Validar tipoDecorado
    if (!matrizPrecios[tipoDecorado]) {
      result.error = `Tipo de decorado no encontrado: ${tipoDecorado}`;
      return result;
    }
  
    // Verificar superficie
    const superficies = Object.keys(matrizPrecios[tipoDecorado]);
    const superficieValida = superficies.find(s => s.split(" / ").includes(superficieFinal));
    if (!superficieValida) {
      result.error = `Superficie no encontrada: ${superficieFinal}`;
      return result;
    }
  
    // Opciones en esa superficie
    const opcionesSuperficie = matrizPrecios[tipoDecorado][superficieValida];
    const opcion = opcionesSuperficie.find(op => op.medida.toLowerCase() === medida.toLowerCase());
    if (!opcion) {
      result.error = `Medida no encontrada: ${medida}`;
      return result;
    }
  
    // Cantidad mínima
    const neededQty = opcion.cantidadMinima;
    result.neededQtyForMin = neededQty;
  
    console.log("LA OPCIÓN ES:", opcion)
    // Cálculo
    if (cantidad >= neededQty) {
      // Usa precio mínimo por unidad
      result.isMinPriceUsed = true;
      console.log("DECORADO CON PRECIO MÍNIMO ES:", opcion.precioMinimo)
      console.log("LA CANTIDAD", cantidad)
      console.log("EL TOTAL", (cantidad * opcion.precioMinimo) / .67)
      result.totalPrice = (cantidad * opcion.precioMinimo) / .67;
    } else {
      // Usa precio máximo como total
      result.isMinPriceUsed = false;
      result.totalPrice = opcion.precioMaximo;
    }
  
    // Precio unitario
    if (cantidad > 0) {
      result.unitPrice = result.totalPrice / cantidad;
    }
  
    return result;
  }
  
  /* =========================================================================
     OBTENER LISTADO DE MEDIDAS PARA UNA SUPERFICIE
     ========================================================================= */
  function obtenerMedidasPorTipoYSuperficie(tipoDecorado, superficie) {
    let superficieFinal = superficie.toUpperCase();
    if (!matrizPrecios[tipoDecorado]) return [];
  
    const superficies = Object.keys(matrizPrecios[tipoDecorado]);
    console.log("superficies", superficies);
    const superficieValida = superficies.find(s => s.split(" / ").includes(superficieFinal));
      console.log("superficieValida", superficieValida);
    if (!superficieValida) return [];
  
    const opcionesSuperficie = matrizPrecios[tipoDecorado][superficieValida];
    return opcionesSuperficie.map(op => op.medida);
  }
  
  /* =========================================================================
     LÓGICA PRINCIPAL
     ========================================================================= */
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Referencias a elementos
    const precioProducto = document.getElementById('precioProducto'); 
    // Este elemento contiene tu precio base, por ejemplo: "$ 40.60 MXN"
    
    const decoradoSelect = document.getElementById('decorado-select');
    const medidaSelect = document.getElementById('medida-select');
    const qtyInput = document.querySelector('input[name=quantity]') || document.querySelector('.quantity__input');
  
    const qtyPlusBtns = document.querySelectorAll('.qty-button.qty-plus.no-js-hidden');
    const qtyMinusBtns = document.querySelectorAll('.qty-button.qty-minus.no-js-hidden');
  
    // 2. Guardamos el PRECIO BASE ORIGINAL para no “pisarlo” en cada recalculo
    const basePriceStr = precioProducto.innerText || ""; // Ej: "$ 40.60 MXN"
    // Extraemos sólo la parte numérica
    const basePriceNumOriginal = parseFloat(basePriceStr.replace(/[^0-9.]/g, '')) || 0;
  
    // 3. Creamos un contenedor para el resultado del decorado
    const precioDecoradoContainer = document.createElement('div');
    precioDecoradoContainer.id = 'precio-decorado-container';
    precioDecoradoContainer.style.marginTop = '10px';
  precioDecoradoContainer.style.fontWeight = 'bold';
    precioDecoradoContainer.style.display = 'none';
  
  
    // Lo insertamos debajo del select de medida
    if (medidaSelect) {
      medidaSelect.parentNode.insertBefore(precioDecoradoContainer, medidaSelect.nextSibling);
    }
  
    // Función para poblar el select de medidas
    function poblarSelectMedidas() {
      medidaSelect.innerHTML = '';
      const tipoDecorado = decoradoSelect.value;
  
      if (tipoDecorado === 'Sin decorado') {
        medidaSelect.disabled = true;
        medidaSelect.innerHTML = '<option value="N/A" selected>N/A</option>';
        return;
       }

      if (!tipoDecorado) {
        medidaSelect.disabled = true;
        medidaSelect.innerHTML = '<option value="">Seleccione primero el tipo de decorado</option>';
        return;
      }
  
      // Obtenemos medidas según la superficie del producto
      const superficieProducto = "{{ product.metafields.custom.superficie }}";
      const medidas = obtenerMedidasPorTipoYSuperficie(tipoDecorado, superficieProducto);
  
      if (medidas.length === 0) {
        medidaSelect.disabled = true;
        medidaSelect.innerHTML = '<option value="">No hay medidas para esta superficie</option>';
        return;
      }
  
      medidaSelect.disabled = false;
      medidaSelect.innerHTML = '<option value="" disabled selected>Seleccione medida</option>';
      medidas.forEach(m => {
        const opt = document.createElement('option');
        opt.value = m;
        opt.textContent = m;
        medidaSelect.appendChild(opt);
      });
    }
  
    function actualizarPrecio() {
      console.log("SE ACTUALIZA EL PRECIO JEJE", decoradoSelect)
      const tipoDecorado = decoradoSelect.value;
      console.log("LLEGUÉ AQUÍ")
      const medida = medidaSelect.value;
      console.log("LLEGUÉ AQUÍ 2")
      const cantidad = qtyInput ? (parseFloat(qtyInput.value) || 0) : 1;
    
      if (tipoDecorado === 'Sin decorado') {
        precioDecoradoContainer.innerText = "";
        precioProducto.innerText = `$ ${basePriceNumOriginal.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} MXN`;
        let decoradoProperty = document.getElementById('decoradoProperty');
        let uniqueId = document.getElementById('uniqueProperty');
        decoradoProperty.setAttribute("value", "0");
        uniqueId.setAttribute("value", "Sin decorado");
        return;
      }

      // Si falta algo, no calculamos
      if (!tipoDecorado || !medida || cantidad <= 0) {
        precioDecoradoContainer.innerText = "";
        // Revertir el texto del precio producto a su base (opcional, depende de tu UX)
        precioProducto.innerText = `$ ${basePriceNumOriginal.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} MXN`;
        return;
      }
    
      // 1) Calcular precio del DECORADO
      const superficieProducto = "{{ product.metafields.custom.superficie }}";
      const detail = calcularPrecioDecoradoConDetalle(tipoDecorado, superficieProducto, cantidad, medida);
      if (detail.error) {
        precioDecoradoContainer.innerText = detail.error;
        return;
      }
    
      // Formateamos decimales
      const totalPriceDecorado = detail.totalPrice.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const unitPriceDecorado = detail.unitPrice.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    
      // Mensaje adicional
      let minPriceMsg = `Para obtener el precio mínimo necesitas al menos ${detail.neededQtyForMin} unidades.`;
      if (detail.isMinPriceUsed) {
        minPriceMsg = `Estás recibiendo el precio mínimo (desde ${detail.neededQtyForMin} uds).`;
      }
    
      // Mostramos info del decorado
      const msg = `
        Precio total de decorado: $${totalPriceDecorado}<br/>
        Precio unitario (decorado): $${unitPriceDecorado} por pieza<br/>
        ${minPriceMsg}
      `;
      precioDecoradoContainer.innerHTML = msg;
    
      // 2) Calcular el precio final (Producto + Decorado)
      //    - El precio base original del producto * la cantidad
      const productSubtotal = basePriceNumOriginal * cantidad;

      console.log("LA CANTIDAD ES", cantidad)
      //    - Sumamos el precio total del decorado
      const finalTotal = (productSubtotal + detail.totalPrice) / cantidad;
    
      // 3) Mostrar en pantalla el precio final
      //    - Ej: "$ 1,120.75 MXN"
      precioProducto.innerText = `$ ${finalTotal.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} MXN`;
    
      let decoradoProperty = document.getElementById('decoradoProperty');
      let uniqueId = document.getElementById('uniqueProperty');
      decoradoProperty.setAttribute("value", totalPriceDecorado);
      uniqueId.setAttribute("value", tipoDecorado + ' - ' + medida);
    }
    // EVENTOS
    // Al cambiar TIPO DECORADO
    if (decoradoSelect) {
      decoradoSelect.addEventListener('change', () => {
        poblarSelectMedidas();
        actualizarPrecio();
      });
    }
  
    // Al cambiar MEDIDAS
    if (medidaSelect) {
      medidaSelect.addEventListener('change', actualizarPrecio);
    }
  
    // Al cambiar/teclear la CANTIDAD
    if (qtyInput) {
      qtyInput.addEventListener('change', actualizarPrecio);
      qtyInput.addEventListener('keyup', actualizarPrecio);
    }
  
    // Botones + y -
    qtyPlusBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        let currentVal = parseFloat(qtyInput.value) || 0;
        currentVal += 1;
        qtyInput.value = currentVal;
        actualizarPrecio();
      });
    });
  
    qtyMinusBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        let currentVal = parseFloat(qtyInput.value) || 0;
        if (currentVal > 1) {
          currentVal -= 1;
          qtyInput.value = currentVal;
          actualizarPrecio();
        }
      });
    });
  });
</script>